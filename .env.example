# Copy to .env for local development (`netlify dev` loads it).
# In production, set these as Netlify environment variables.
MODEL_PROVIDER=anthropic
# Named CLAUDE_API_KEY rather than ANTHROPIC_API_KEY so that variables the
# Netlify CLI injects under ANTHROPIC_* names cannot replace it.
CLAUDE_API_KEY=
# Optional; defaults to claude-sonnet-5-5.
CLAUDE_MODEL=
